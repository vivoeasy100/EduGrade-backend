# ============================================================
# EduGrade Backend — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores
# ============================================================

# --- Banco de Dados ---
# SQLite (desenvolvimento, sem instalação extra):
DATABASE_URL=sqlite:///./edugrade.db
# PostgreSQL (produção):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/edugrade

# --- Segurança (JWT) ---
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-secreta-forte-de-pelo-menos-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS (origens permitidas para o frontend) ---
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:3000"]

# --- AI Provider ---
# mock = sem API externa (padrão dev); ollama = local; fcc_claude = Claude via FCC
AI_PROVIDER=mock
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- OCR ---
TESSERACT_CMD=tesseract
# OCR_ENGINE=tesseract

# --- Email (opcional) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASSWORD=sua-senha-de-app

# --- Storage ---
STORAGE_PATH=./storage

# --- Debug / Logging ---
DEBUG=true
LOG_LEVEL=INFO
